# Odysseus .env — the three settings to change from the upstream example.
# See: https://docs.45homelab.com/articles/odysseus/#step-6-configure-env

APP_BIND=0.0.0.0       # bind to all interfaces so the UI is reachable on the LAN
AUTH_ENABLED=true      # leave on — login is required
LOCALHOST_BYPASS=false # leave off
